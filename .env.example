# ==========================================
# OgeDecor Environment Variables
# ==========================================

# 1. Neon Database Connection
# Replace with your actual Neon PostgreSQL connection string
# (Ensure ?sslmode=require is included at the end)
DATABASE_URI="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="${DATABASE_URI}"

# 2. Vercel Blob Storage Token
# From Vercel Dashboard -> Storage -> Your Blob Store -> .env.local tab
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Payload CMS Secret Key
# A secure random secret string for session cookies and token signing
PAYLOAD_SECRET="ogedecor-super-secret-key-change-this-for-production"

# 4. Server URL
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# 5. Resend Email Notifications (Store Orders & Inquiries)
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Verified domain sender, e.g. "Ogedecor Concierge <orders@ogedecor.com>"
# (During testing without a custom domain, you can use "Ogedecor <onboarding@resend.dev>")
RESEND_FROM_EMAIL="Ogedecor Concierge <onboarding@resend.dev>"
# Email to receive new order and consultation alerts
ADMIN_NOTIFICATION_EMAIL="admin@ogedecor.com"

# 6. Cloudinary (Optional legacy support)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
